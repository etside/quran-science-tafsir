{
  "name": "quran-science-tafsir",
  "version": "1.4.0",
  "private": true,
  "description": "Scientific Tafsir of the Quran — bilingual static site + Capacitor Android",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 8000",
    "build:db": "python3 scripts/build_db.py",
    "cap:sync": "npx cap sync android",
    "cap:add": "npx cap add android",
    "cap:open": "npx cap open android",
    "android:assemble": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
